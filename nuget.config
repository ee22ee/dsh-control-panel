<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    本机 dotnet restore 访问 api.nuget.org 时 schannel 握手失败
    （报「安全包中没有可用的凭证」；node 走 OpenSSL 可正常连通，说明是 schannel 侧问题）。
    因此清空默认源，改用本地 packages/ 目录：nupkg 由 fetch-nupkg.mjs 用 node 抓取。
    换机器或网络恢复后，删掉下面 <clear /> 即可回到 nuget.org。
  -->
  <packageSources>
    <clear />
    <add key="local" value="packages" />
  </packageSources>

  <!-- 避免 restore 去联网查证书吊销 -->
  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>
